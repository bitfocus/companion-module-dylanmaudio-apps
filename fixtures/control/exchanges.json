{
  "schema": "dylanmaudio-control-fixtures/1",
  "source": "docs/brief-companion-control.md §2 (2026-09-11); server shared/control_api.py",
  "note": "Authority for the Companion control API wire shapes (/ctl/v1/), BOTH sides: the monorepo builds a real ControlServer from 'app' + 'catalogue' + 'initial_state' and replays 'cases' in order; the Companion module mocks the server from the same file (vendored by tools/sync_fixtures.sh, monorepo -> module repo, like fixtures/api/). The replay harness's handlers record every call, return the text in 'refusals' as {\"error\": text}, and on success publish the resolved value to the control's state key, as an app would. 'setup' sets the app's two switches before a case (defaults: allowed true, locked false). 'calls' asserts the handler invocations a case makes, as [control, value] pairs. Matching: response bodies are SUBSET-matched (extra server keys allowed); '<str>'/'<int>' match any value of that type. The catalogue itself must serialise EXACTLY as written here. Never edit a case to make a test green — change the brief first, then both sides.",
  "app": {"id": "demo", "name": "Demo App", "version": "1.0.0"},
  "catalogue": {
    "controls": [
      {"id": "demo.run", "label": "Run", "kind": "toggle", "state": "demo.running",
       "safety": {"off": "critical"}},
      {"id": "demo.mode", "label": "Failback mode", "kind": "choice", "state": "demo.mode",
       "choices": [["auto", "Automatic"], ["latch", "Latch until Reset"]], "safety": "critical"},
      {"id": "demo.reset", "label": "Reset — fail back to primary", "kind": "action",
       "enabled_when": "demo.reset_available"},
      {"id": "demo.threshold", "label": "Threshold", "kind": "number", "state": "demo.threshold_db",
       "min": -60, "max": 0, "step": 1},
      {"id": "demo.start_tc", "label": "Generate start", "kind": "text",
       "pattern": "\\d{2}:\\d{2}:\\d{2}:\\d{2}"}
    ],
    "state": [
      {"key": "demo.running", "label": "Running", "type": "bool"},
      {"key": "demo.mode", "label": "Failback mode", "type": "enum", "values": ["auto", "latch"]},
      {"key": "demo.state", "label": "State", "type": "enum", "values": ["stopped", "ok", "lost", "latched"]},
      {"key": "demo.reset_available", "label": "Reset available", "type": "bool"},
      {"key": "demo.threshold_db", "label": "Threshold", "type": "number", "unit": "dB"},
      {"key": "demo.level_db", "label": "Level", "type": "number", "unit": "dB", "max_rate_hz": 10}
    ]
  },
  "initial_state": {
    "demo.running": false, "demo.mode": "auto", "demo.state": "stopped",
    "demo.reset_available": false, "demo.threshold_db": -45, "demo.level_db": null
  },
  "refusals": {"demo.reset": "Signal is still below threshold — stay on backup."},
  "cases": [
    {"id": "info.ok",
     "request": {"method": "GET", "path": "/ctl/v1/info"},
     "response": {"status": 200, "body": {"v": 1, "ctl": 1, "app": "demo", "name": "Demo App",
       "version": "1.0.0", "catalogue_hash": "<str>", "allowed": true, "locked": false, "seq": "<int>"}}},
    {"id": "catalogue.ok",
     "request": {"method": "GET", "path": "/ctl/v1/catalogue"},
     "response": {"status": 200, "body": {"v": 1, "app": "demo", "name": "Demo App", "hash": "<str>"}}},
    {"id": "state.ok",
     "request": {"method": "GET", "path": "/ctl/v1/state"},
     "response": {"status": 200, "body": {"v": 1, "seq": "<int>", "values": {
       "demo.running": false, "demo.mode": "auto", "demo.state": "stopped", "demo.threshold_db": -45}}}},
    {"id": "cmd.toggle.on",
     "request": {"method": "POST", "path": "/ctl/v1/cmd",
       "body": {"v": 1, "cid": "k1", "control": "demo.run", "value": "on"}},
     "response": {"status": 200, "body": {"v": 1, "ok": true, "cid": "k1", "control": "demo.run", "value": true}},
     "calls": [["demo.run", true]]},
    {"id": "cmd.toggle.flip",
     "request": {"method": "POST", "path": "/ctl/v1/cmd",
       "body": {"v": 1, "cid": "k2", "control": "demo.run", "value": "toggle"}},
     "response": {"status": 200, "body": {"ok": true, "cid": "k2", "value": false}},
     "calls": [["demo.run", false]]},
    {"id": "cmd.choice.next",
     "request": {"method": "POST", "path": "/ctl/v1/cmd",
       "body": {"v": 1, "cid": "k3", "control": "demo.mode", "value": "next"}},
     "response": {"status": 200, "body": {"ok": true, "cid": "k3", "value": "latch"}},
     "calls": [["demo.mode", "latch"]]},
    {"id": "cmd.choice.bad_value",
     "request": {"method": "POST", "path": "/ctl/v1/cmd",
       "body": {"v": 1, "cid": "k4", "control": "demo.mode", "value": "sideways"}},
     "response": {"status": 400, "body": {"ok": false, "cid": "k4", "error": {"code": "bad_value"}}},
     "calls": []},
    {"id": "cmd.number.nudge",
     "request": {"method": "POST", "path": "/ctl/v1/cmd",
       "body": {"v": 1, "cid": "k5", "control": "demo.threshold", "value": {"nudge": 1}}},
     "response": {"status": 200, "body": {"ok": true, "cid": "k5", "value": -44}},
     "calls": [["demo.threshold", -44]]},
    {"id": "cmd.number.out_of_range",
     "request": {"method": "POST", "path": "/ctl/v1/cmd",
       "body": {"v": 1, "cid": "k6", "control": "demo.threshold", "value": 5}},
     "response": {"status": 400, "body": {"ok": false, "error": {"code": "bad_value"}}},
     "calls": []},
    {"id": "cmd.text.ok",
     "request": {"method": "POST", "path": "/ctl/v1/cmd",
       "body": {"v": 1, "cid": "k7", "control": "demo.start_tc", "value": "01:00:00:00"}},
     "response": {"status": 200, "body": {"ok": true, "value": "01:00:00:00"}},
     "calls": [["demo.start_tc", "01:00:00:00"]]},
    {"id": "cmd.text.bad_value",
     "request": {"method": "POST", "path": "/ctl/v1/cmd",
       "body": {"v": 1, "cid": "k8", "control": "demo.start_tc", "value": "1:2"}},
     "response": {"status": 400, "body": {"ok": false, "error": {"code": "bad_value"}}},
     "calls": []},
    {"id": "cmd.action.refused",
     "request": {"method": "POST", "path": "/ctl/v1/cmd",
       "body": {"v": 1, "cid": "k9", "control": "demo.reset"}},
     "response": {"status": 409, "body": {"ok": false, "cid": "k9", "error": {"code": "refused",
       "message": "Signal is still below threshold — stay on backup."}}},
     "calls": [["demo.reset", null]]},
    {"id": "cmd.unknown_control",
     "request": {"method": "POST", "path": "/ctl/v1/cmd",
       "body": {"v": 1, "cid": "k10", "control": "demo.nope"}},
     "response": {"status": 404, "body": {"ok": false, "error": {"code": "unknown_control"}}},
     "calls": []},
    {"id": "cmd.locked.critical",
     "setup": {"locked": true},
     "request": {"method": "POST", "path": "/ctl/v1/cmd",
       "body": {"v": 1, "cid": "k11", "control": "demo.mode", "value": "auto"}},
     "response": {"status": 423, "body": {"ok": false, "error": {"code": "locked"}}},
     "calls": []},
    {"id": "cmd.locked.toggle_on_allowed",
     "setup": {"locked": true},
     "request": {"method": "POST", "path": "/ctl/v1/cmd",
       "body": {"v": 1, "cid": "k12", "control": "demo.run", "value": "on"}},
     "response": {"status": 200, "body": {"ok": true, "value": true}},
     "calls": [["demo.run", true]],
     "note": "Only switching Run OFF is critical ({\"off\": \"critical\"})."},
    {"id": "cmd.locked.toggle_off_refused",
     "setup": {"locked": true},
     "request": {"method": "POST", "path": "/ctl/v1/cmd",
       "body": {"v": 1, "cid": "k13", "control": "demo.run", "value": "off"}},
     "response": {"status": 423, "body": {"ok": false, "error": {"code": "locked"}}},
     "calls": []},
    {"id": "cmd.not_allowed",
     "setup": {"allowed": false},
     "request": {"method": "POST", "path": "/ctl/v1/cmd",
       "body": {"v": 1, "cid": "k14", "control": "demo.run", "value": "off"}},
     "response": {"status": 403, "body": {"ok": false, "error": {"code": "not_allowed"}}},
     "calls": []},
    {"id": "state.readable_when_not_allowed",
     "setup": {"allowed": false},
     "request": {"method": "GET", "path": "/ctl/v1/state"},
     "response": {"status": 200, "body": {"v": 1, "values": {"demo.running": true}}}},
    {"id": "cmd.bad_request",
     "request": {"method": "POST", "path": "/ctl/v1/cmd", "body": {"v": 1, "cid": "k15"}},
     "response": {"status": 400, "body": {"ok": false, "error": {"code": "bad_request"}}},
     "calls": []},
    {"id": "cmd.bad_content_type",
     "request": {"method": "POST", "path": "/ctl/v1/cmd", "content_type": "text/plain",
       "body": {"v": 1, "cid": "k16", "control": "demo.run", "value": "on"}},
     "response": {"status": 415, "body": {"ok": false, "error": {"code": "bad_content_type"}}},
     "calls": [],
     "note": "A cross-site form can send text/plain without a preflight; application/json it cannot."},
    {"id": "stream.resync",
     "request": {"method": "GET", "path": "/ctl/v1/stream?cursor=-1"},
     "response": {"status": 409, "body": {"ok": false, "error": {"code": "resync"}}},
     "note": "cursor=-1 is always older than the ring's oldest entry."},
    {"id": "security.origin",
     "request": {"method": "GET", "path": "/ctl/v1/info", "headers": {"Origin": "https://example.com"}},
     "response": {"status": 403, "body": {"ok": false, "error": {"code": "forbidden_origin"}}}},
    {"id": "security.host",
     "request": {"method": "GET", "path": "/ctl/v1/info", "headers": {"Host": "attacker.example"}},
     "response": {"status": 403, "body": {"ok": false, "error": {"code": "forbidden_host"}}},
     "note": "DNS rebinding: a hostname that resolves to 127.0.0.1 must still be refused."},
    {"id": "not_found",
     "request": {"method": "GET", "path": "/ctl/v1/nope"},
     "response": {"status": 404, "body": {"ok": false, "error": {"code": "not_found"}}}}
  ]
}
